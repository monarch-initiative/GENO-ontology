            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002162"/>
        </owl:propertyChainAxiom>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0002254"/>
