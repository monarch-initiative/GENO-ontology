    <!-- http://purl.obolibrary.org/obo/OBI_0002248 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002248">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002243"/>
