        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GENO_0000481"/>
        <obo:IAO_0000115>A repeat_region containing repeat_units of 2 to 10 bp repeated in tandem.</obo:IAO_0000115>
