        <obo:IAO_0000116>Modified definition in 2013 Philly OBI workshop</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">James Malone</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">PERSON: James Malone</obo:IAO_0000119>
        <rdfs:label xml:lang="en">data transformation objective</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0200171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0200171">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0200172"/>
            </owl:Restriction>
        </owl:equivalentClass>
