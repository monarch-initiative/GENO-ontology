        <rdfs:label>Stage IIB (AJCC 7th)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002320 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002320">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002314"/>
        <obo:IAO_0000111>Stage IIC (AJCC 7th)</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A clinical tumor stage group according to AJCC 7th edition indicating cancers with increasing tumor or nodal extent but less than in Stage III and with differing characteristics from IIA and IIB.</obo:IAO_0000115>
        <obo:IAO_0000117>Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
        <obo:IAO_0000118>Stage IIC</obo:IAO_0000118>
