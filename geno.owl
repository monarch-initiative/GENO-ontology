        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>Stage IIA (FIGO)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0002334 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002334">
