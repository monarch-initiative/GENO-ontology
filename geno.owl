        <obo:IAO_subset>DBVAR</obo:IAO_subset>
        <obo:IAO_xref>http:http\://en.wikipedia.org/wiki/Uniparental_disomy</obo:IAO_xref>
        <rdfs:label>UPD</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SO_0001745 -->

