        <obo:IAO_id>SO:0000248</obo:IAO_id>
        <rdfs:label>sequence_length_variation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SO_0000281 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SO_0000281">
