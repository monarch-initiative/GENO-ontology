    <!-- http://purl.obolibrary.org/obo/OBI_0002206 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/OBI_0002206">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0002205"/>
        <obo:IAO_0000111>G1: Well differentiated</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
        <obo:IAO_0000115>A histologic grade according to AJCC 7th edition indicating that the tumor cells and the organization of the tumor tissue appear close to normal.</obo:IAO_0000115>
