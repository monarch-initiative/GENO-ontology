                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/GENO_0000207"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000911"/>
            </owl:Restriction>
