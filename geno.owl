        <obo:IAO_0000117>Chris Stoeckert, Helena Ellis</obo:IAO_0000117>
        <obo:IAO_0000118>pT: Pathologic spread colorectal primary tumor (AJCC 7th Edition)</obo:IAO_0000118>
        <obo:IAO_0000119>NCI BBRB, OBI</obo:IAO_0000119>
        <obo:IAO_0000234>NCI BBRB</obo:IAO_0000234>
        <rdfs:label>pathologic primary tumor stage for colon and rectum according to AJCC 7th edition</rdfs:label>
    </owl:Class>
    


